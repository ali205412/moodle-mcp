 /**
+ * Whether the current user may see the given mentee's grades.
+ *
+ * Allowed: the mentee themself, a parent of the mentee, staff with moodle/grade:viewall
+ * in the given context, or a token the parent app issued for one child (get_mentee_token
+ * records the parent as creatorid) when that same parent is also the mentee's parent.
+ * The last case lets the app switch between siblings without fetching a new token.
+ *
+ * @param int $menteeid The mentee user ID
+ * @param context|null $context Context to check moodle/grade:viewall in, if any
+ * @return bool
+ */
+function local_aspireparent_can_view_mentee($menteeid, $context = null) {
+    global $DB, $USER;
+
+    if ($menteeid == $USER->id || local_aspireparent_is_parent_of($USER->id, $menteeid)) {
+        return true;
+    }
+    if ($context && has_capability('moodle/grade:viewall', $context)) {
+        return true;
+    }
+    $wstoken = optional_param('wstoken', '', PARAM_ALPHANUM);
+    if ($wstoken !== '') {
+        $creatorid = $DB->get_field('external_tokens', 'creatorid', ['token' => $wstoken, 'userid' => $USER->id]);
+        if ($creatorid && $creatorid != $USER->id
+                && local_aspireparent_is_parent_of($creatorid, $USER->id)
+                && local_aspireparent_is_parent_of($creatorid, $menteeid)) {
+            return true;
+        }
+    }
+    return false;
+}
